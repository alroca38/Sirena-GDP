# Copia este archivo como .env y reemplaza los valores locales.
POSTGRES_USER=sirena
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_DB=sirena
DB_URL=postgresql+psycopg://sirena:cambia-esta-clave-local@postgres:5432/sirena

ROBLE_BASE_URL=https://roble-api.test-openlab.uninorte.edu.co
ROBLE_CONTRACT_ID=

# Genera una clave aleatoria larga y mantenla estable mientras exista n8ndata.
N8N_ENCRYPTION_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
N8N_WEBHOOK_URL=http://n8n:5678/webhook/person-sync
N8N_TIMEOUT_SECONDS=3
