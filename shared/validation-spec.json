{
    "conventions": {
        "evaluationOrder": "",
        "optionalFieldEmpty": "",
        "normalization": {
            "trim": "Quita espacios al inicio y al final de la cadena",
            "collapseSpaces": "Reemplaza múltiples espacios consecutivos con un solo espacio",
            "lowercase": "Convierte la cadena a minúsculas"
        },
        "ruleType": {
            "required": "El campo es obligatorio",
            "maxLength": "La longitud máxima permitida es {maxLength} caracteres",
            "exactLength": "La longitud exacta permitida es {exactLength} caracteres",
            "pattern": "Debe cumplir con el patrón especificado: {pattern}",
            "enum": "Debe ser uno de los valores permitidos: {enumValues}",
            "dateFormat": "Debe tener el formato de fecha especificado",
            "realDate": "Debe ser una fecha válida",
            "noFutureDate": "No puede ser una fecha futura",
            "minDate": "Debe ser una fecha posterior a {minDate}",
            "maxSize": "El tamaño máximo permitido es {maxSize} bytes",
            "realFileType": "El tipo se determina por los primeros bytes (firma), no por la extensión ni el Content-Type declarado"
        },
        "placeHoldersMessage": [
            "{value}",
            "{tag}"
        ]
    },
    "abrvMonths": [
        "ene",
        "feb",
        "mar",
        "abr",
        "may",
        "jun",
        "jul",
        "ago",
        "sep",
        "oct",
        "nov",
        "dic"
    ],
    "patterns": {
        "onlyDigits": "^[0-9]+$",
        "name": "^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+([ '’-][A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+)*$",
        "email": "^[A-Za-z0-9._%+-]+@([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\\.)+[A-Za-z]{2,}$",
        "isoDate": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "textDate": "^(0[1-9]|[12][0-9]|3[01])-(ene|feb|mar|abr|may|jun|jul|ago|sep|oct|nov|dic)-[0-9]{4}$"
    },
    "fields": {
        "documentType": {
            "tag": "Tipo de documento",
            "type": "enum",
            "mandatory": true,
            "values": [
                {
                    "code": "TI",
                    "tag": "Tarjeta de identidad"
                },
                {
                    "code": "CC",
                    "tag": "Cédula"
                }
            ],
            "rules": [
                {
                    "id":"required",
                    "message": "Seleccione el tipo de documento."
                },
                {
                    "id": "enum",
                    "message": "Seleccione una opción válida de la lista."
                }
            ]
        },
        "documentId": {
            "tag": "Nro. Documento",
            "type": "text",
            "mandatory": true,
            "normalize": [
                "trim"
            ],
            "rules": [
                {
                    "id": "required",
                    "message": "El número de documento es obligatorio."
                },
                {
                    "id": "pattern",
                    "pattern": "onlyDigits",
                    "message": "El número de documento debe contener solo dígitos."
                },
                {
                    "id": "maxLength",
                    "value": 10,
                    "message": "No debe superar {value} dígitos."
                }
            ]
        },
        "firstName": {
            "tag": "Primer Nombre",
            "type": "text",
            "mandatory": true,
            "normalize": [
                "trim",
                "collapseSpaces"
            ],
            "rules": [
                {
                    "id": "required",
                    "message": "El primer nombre es obligatorio."
                },
                {
                    "id": "maxLength",
                    "value": 30,
                    "message": "No debe superar {value} caracteres."
                },
                {
                    "id": "pattern",
                    "pattern": "name",
                    "message": "El primer nombre solo puede contener letras, espacios, apóstrofes y guiones."
                }
            ]
        },
        "secondName": {
            "tag": "Segundo Nombre",
            "type": "text",
            "mandatory": false,
            "normalize": [
                "trim",
                "collapseSpaces"
            ],
            "rules": [
                {
                    "id": "maxLength",
                    "value": 30,
                    "message": "No debe superar {value} caracteres."
                },
                {
                    "id": "pattern",
                    "pattern": "name",
                    "message": "El segundo nombre solo puede contener letras, espacios, apóstrofes y guiones."
                }
            ]
        },
        "lastNames": {
            "tag": "Apellidos",
            "type": "text",
            "mandatory": true,
            "normalize": [
                "trim",
                "collapseSpaces"
            ],
            "rules": [
                {
                    "id": "required",
                    "message": "Los apellidos son obligatorios."
                },
                {
                    "id": "maxLength",
                    "value": 60,
                    "message": "No debe superar {value} caracteres."
                },
                {
                    "id": "pattern",
                    "pattern": "name",
                    "message": "Los apellidos solo pueden contener letras, espacios, apóstrofes y guiones."
                }
            ]
        },
        "birthdate": {
            "tag": "Fecha de Nacimiento",
            "type": "date",
            "mandatory": true,
            "normalize": [
                "trim",
                "lowercase"
            ],
            "uiFormat": "dd-mmm-yyyy",
            "apiFormat": "YYYY-MM-DD",
            "inputFormats": [
                {
                    "id": "calendar",
                    "format": "YYYY-MM-DD",
                    "pattern": "isoDate"
                },
                {
                    "id": "text",
                    "format": "dd-mmm-yyyy",
                    "pattern": "textDate"
                }
            ],
            "rules": [
                {
                    "id": "required",
                    "message": "La fecha de nacimiento es obligatoria."
                },
                {
                    "id": "dateFormat",
                    "message": "Use el calendario o escriba la fecha como dd-mmm-yyyy (por ejemplo 05-mar-1998)."
                },
                {
                    "id": "realDate",
                    "message": "La fecha ingresada no es válida."
                },
                {
                    "id": "noFutureDate",
                    "message": "La fecha de nacimiento no puede ser futura."
                },
                {
                    "id": "minDate",
                    "value": "1900-01-01",
                    "message": "La fecha de nacimiento debe ser posterior a {value}."
                }
            ]
        },
        "genre": {
            "tag": "Género",
            "type": "enum",
            "mandatory": true,
            "values": [
                {
                    "code": "MASCULINO",
                    "tag": "Masculino"
                },
                {
                    "code": "FEMENINO",
                    "tag": "Femenino"
                },
                {
                    "code": "NO_BINARIO",
                    "tag": "No binario"
                },
                {
                    "code": "PREFIERO_NO_REPORTAR",
                    "tag": "Prefiero no reportar"
                }
            ],
            "rules": [
                {
                    "id":"required",
                    "message": "Seleccione el género."
                },
                {
                    "id": "enum",
                    "message": "Seleccione una opción válida de la lista."
                }
            ]
        },
        "email": {
            "tag": "Correo electrónico",
            "type": "text",
            "mandatory": true,
            "normalize": [
                "trim",
                "lowercase"
            ],
            "rules": [
                {
                    "id": "required",
                    "message": "El correo electrónico es obligatorio."
                },
                {
                    "id": "maxLength",
                    "value": 254,
                    "message": "No debe superar {value} caracteres."
                },
                {
                    "id": "pattern",
                    "pattern": "email",
                    "message": "El correo electrónico no tiene un formato válido."
                }
            ]
        },
        "phoneNumber": {
            "tag": "Celular",
            "type": "text",
            "mandatory": true,
            "normalize": [
                "trim"
            ],
            "rules": [
                {
                    "id": "required",
                    "message": "El número de teléfono es obligatorio."
                },
                {
                    "id": "pattern",
                    "pattern": "onlyDigits",
                    "message": "El número de teléfono debe contener solo dígitos."
                },
                {
                    "id": "exactLength",
                    "value": 10,
                    "message": "Debe tener exactamente {value} dígitos."
                }
            ]
        },
        "photo": {
            "tag": "Foto",
            "type": "file",
            "mandatory": false,
            "typesAllowed": [
                {
                    "mime": "image/jpeg",
                    "extensions": [".jpg", ".jpeg"],
                    "hexSignature": [
                        {
                            "bytes": "FFD8FF"
                        }
                    ]
                },
                {
                    "mime": "image/png",
                    "extensions": [".png"],
                    "hexSignature": [
                        {
                            "bytes": "89504E470D0A1A0A"
                        }
                    ]
                }
            ],
            "rules": [
                {
                    "id": "maxSize",
                    "value": 2097152,
                    "message": "La foto no puede superar 2 MB."
                },
                {
                    "id": "realFileType",
                    "message": "El archivo debe ser una imagen en formato JPEG o PNG."
                }
            ]
        }
    },
    "httpErrors": {
        "validationError": 422,
        "duplicatedDocument": 409,
        "notFound": 404,
        "oversizedPhoto": 413,
        "invalidPhoto": 415,
        "serverError": 500
    },
